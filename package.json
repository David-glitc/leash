{
  "name": "leash",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A spending leash for AI agents on QoreChain: say what the agent may spend, Leash makes the chain enforce it, then attacks itself with a stolen classical key.",
  "license": "Apache-2.0",
  "scripts": {
    "test": "forge test && tsx --test tools/*.test.ts",
    "compile": "tsx tools/leash.ts compile",
    "demo:local": "tsx tools/local.ts",
    "demo:local:v2": "tsx tools/local-v2.ts",
    "demo:monitor": "tsx tools/local-monitor.ts",
    "monitor": "tsx tools/monitor.ts",
    "accounts": "tsx tools/accounts.ts",
    "testnet": "tsx tools/testnet.ts",
    "testnet:v2": "tsx tools/testnet.ts v2",
    "typecheck": "tsc --noEmit",
    "mcp": "tsx mcp/server.ts",
    "verify": "tsx tools/verify.ts",
    "campaign": "tsx tools/campaign.ts",
    "docs": "python3 site/build.py",
    "mcp:smoke": "tsx mcp/smoke.ts",
    "mcp:e2e": "tsx mcp/e2e-local.ts",
    "mcp:live": "tsx mcp/live-demo.ts",
    "mcp:live:v2": "tsx mcp/live-demo-v2.ts"
  },
  "dependencies": {
    "@cosmjs/stargate": "^0.39.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@qorechain/evm": "^0.14.0",
    "@qorechain/sdk": "^0.14.0",
    "viem": "^2.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3"
  }
}
